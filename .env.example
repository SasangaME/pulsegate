# PulseGate — copy to .env and fill in. The real .env is gitignored.
#
# None of these is a secret. The subscription and tenant IDs are identifiers,
# and nothing in this project stores a credential: CI authenticates to Azure
# with a federated OIDC token, and to ghcr.io with the job's own GITHUB_TOKEN.
# They are kept out of the repository because it is public, not because they
# grant access on their own.
#
# Source with:  set -a && . ./.env && set +a

# az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=

# az account show --query tenantId -o tsv
AZURE_TENANT_ID=

# az account show --query user.name -o tsv
# The break-glass Global Administrator — see RUNBOOK.md operation 2.
AZURE_ADMIN_UPN=

# See the region decision in ROADMAP.md.
AZURE_LOCATION=westus3

# Output by v0-bootstrap step 4, once the Entra applications exist.
AZURE_CLIENT_ID=
AZURE_APPLY_CLIENT_ID_DEV=
AZURE_APPLY_CLIENT_ID_STAGE=
AZURE_APPLY_CLIENT_ID_PROD=
